        "query": "UPDATE public.calls\nSET\n    score = $2::jsonb,\n    score_model = $3,\n    scored_at = NOW()\nWHERE call_id = $1\n  AND transcript = $4\nRETURNING call_id, score, score_model, scored_at;",
