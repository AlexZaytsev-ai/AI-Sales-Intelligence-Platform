        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"need_discovery\": {\"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 2},\n    \"need_discovery_reason\": {\"type\": [\"string\", \"null\"]},\n    \"objection_handling\": {\"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 2},\n    \"objection_handling_reason\": {\"type\": [\"string\", \"null\"]},\n    \"product_knowledge\": {\"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 2},\n    \"product_knowledge_reason\": {\"type\": [\"string\", \"null\"]},\n    \"next_step\": {\"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 2},\n    \"next_step_reason\": {\"type\": [\"string\", \"null\"]},\n    \"communication\": {\"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 2},\n    \"communication_reason\": {\"type\": [\"string\", \"null\"]},\n    \"recommendations\": {\n      \"type\": \"array\",\n      \"items\": {\"type\": \"string\", \"minLength\": 1},\n      \"maxItems\": 3,\n      \"description\": \"Конкретные действия для улучшения работы менеджера по фактам разговора. Если рекомендаций нет, верни пустой массив.\"\n    }\n  },\n  \"required\": [\n    \"need_discovery\", \"need_discovery_reason\",\n    \"objection_handling\", \"objection_handling_reason\",\n    \"product_knowledge\", \"product_knowledge_reason\",\n    \"next_step\", \"next_step_reason\",\n    \"communication\", \"communication_reason\",\n    \"recommendations\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
