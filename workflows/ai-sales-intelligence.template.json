        "inputSchema": "\n{\n  \"type\": \"object\",\n  \"properties\": {\n    \"customer_need\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"budget_min\": {\n      \"type\": [\"number\", \"null\"]\n    },\n    \"budget_max\": {\n      \"type\": [\"number\", \"null\"]\n    },\n    \"purchase_timeline\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"objections\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"next_action\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"deal_status\": {\n      \"type\": \"string\",\n      \"enum\": [\"interested\", \"not_interested\", \"unknown\"]\n    }\n  },\n  \"required\": [\n    \"customer_need\",\n    \"budget_min\",\n    \"budget_max\",\n    \"purchase_timeline\",\n    \"objections\",\n    \"next_action\",\n    \"deal_status\"\n  ],\n  \"additionalProperties\": false\n}\n"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        800,
        224
      ],
      "id": "73112dea-d3ae-49f4-9850-59b545a4b1c3",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    call_id,\n    score->>'need_discovery' AS need_discovery,\n    score->>'objection_handling' AS objection_handling,\n    score->>'product_knowledge' AS product_knowledge,\n    score->>'next_step' AS next_step,\n    score->>'communication' AS communication,\n    score->'recommendations' AS recommendations,\n    score_model,\n    scored_at\nFROM public.calls\nWHERE score IS NOT NULL\nORDER BY scored_at DESC\nLIMIT 10;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -368,
        384
      ],
      "id": "4ea9bf45-b610-411e-bf05-df869a3727e3",
      "name": "Execute a SQL query"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.transcript }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "Ты AI-аналитик отдела продаж.\n\nПроанализируй телефонный разговор и извлеки:\n\n1. customer_need — потребность клиента\n2. budget_min — минимальный бюджет\n3. budget_max — максимальный бюджет\n4. purchase_timeline — срок покупки\n5. objections — возражения клиента\n6. next_action — следующее действие\n7. deal_status — interested, not_interested или unknown\n\nПравила: используй только факты из разговора. Не придумывай информацию. Если данных нет, возвращай null. Бюджет записывай числами. Верни только JSON без дополнительных объяснений."
            }
          ]
        },
        "batching": {}
