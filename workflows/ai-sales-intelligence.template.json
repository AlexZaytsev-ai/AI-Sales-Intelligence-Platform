      "name": "Prepare Call Record (Подготовка записи звонка)"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.calls AS c\n    (call_id, transcript, analysis, status)\nVALUES ($1, $2, $3::jsonb, 'analyzed')\nON CONFLICT (call_id)\nDO UPDATE SET\n    transcript = EXCLUDED.transcript,\n    analysis = EXCLUDED.analysis,\n    status = EXCLUDED.status,\n    score = CASE\n        WHEN c.transcript IS DISTINCT FROM EXCLUDED.transcript\n        THEN NULL ELSE c.score\n    END,\n    score_model = CASE\n        WHEN c.transcript IS DISTINCT FROM EXCLUDED.transcript\n        THEN NULL ELSE c.score_model\n    END,\n    scored_at = CASE\n        WHEN c.transcript IS DISTINCT FROM EXCLUDED.transcript\n        THEN NULL ELSE c.scored_at\n    END\nRETURNING id, call_id, status;",
        "options": {
          "queryReplacement": "= {{ [$json.call_id, $json.transcript, JSON.stringify($json.analysis)] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
